# ── Saffron House Restaurant Suite ──────────────────────────────────────────
# Copy this file to `.env` and adjust if needed. Every value has a safe default,
# so the app runs with no .env file at all.

# HTTP port. If this port is busy, the server automatically tries the next
# ten ports (3001, 3002, …) when PORT is not explicitly set.
PORT=3000

# Change this for anything other than a local demo. Sessions are signed with it.
SESSION_SECRET=saffron-house-local-demo-secret-2026

# SQLite database location. Relative paths resolve from the project root.
# DB_PATH=./database/restaurant.db

# Set to `production` when serving behind HTTPS, then also set
# `cookie.secure = true` in server.js.
# NODE_ENV=development
